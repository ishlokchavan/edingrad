# Edingrad — environment variables
# Copy to .env.local for local dev; set the same keys in Vercel project settings.
# Never commit real values. See docs/build-plan.md §10.

# --- Supabase ---------------------------------------------------------------
# Project URL and anon key are safe for the browser (NEXT_PUBLIC_*).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role bypasses RLS — server-only. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Brevo (transactional email) --------------------------------------------
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=no-reply@edingrad.com
BREVO_SENDER_NAME=Edingrad
# Inbox that receives lead / application notifications.
TEAM_INBOX_EMAIL=team@edingrad.com
