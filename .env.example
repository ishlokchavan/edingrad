# Edingrad — environment variables
# Copy to .env.local for local dev; set the same keys in Vercel project settings.
# Never commit real values. See docs/build-plan.md §10.

# --- Supabase ---------------------------------------------------------------
# Project URL and anon key are safe for the browser (NEXT_PUBLIC_*).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role bypasses RLS — server-only. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Brevo (transactional email over SMTP relay) ----------------------------
# From Brevo: Settings -> SMTP & API -> SMTP.
BREVO_SMTP_USER=your-brevo-smtp-login
BREVO_SMTP_KEY=your-brevo-smtp-key
BREVO_FROM_EMAIL=no-reply@edingrad.com
# Optional:
BREVO_FROM_NAME=Edingrad
# Inbox that receives lead / application notifications (defaults to BREVO_FROM_EMAIL).
TEAM_INBOX_EMAIL=team@edingrad.com
